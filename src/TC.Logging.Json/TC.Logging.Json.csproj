<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<Version>1.0.0</Version>
		<Authors></Authors>
		<Copyright>©2025 by Timon Christl</Copyright>
		<PackageProjectUrl>https://github.com/TimonChristl/TC.Logging</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl></RepositoryUrl>
		<Company />
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\TC.Logging\TC.snk</AssemblyOriginatorKeyFile>
		<Description>JsonFileLogSink for TC.Logging</Description>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
	<PropertyGroup Condition="$(TargetFramework) == 'net8.0'">
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<ItemGroup>
	  <None Include="..\..\README.md" Link="README.md">
	    <PackagePath>\</PackagePath>
	    <Pack>true</Pack>
	  </None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="System.Text.Json" Version="9.0.3" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\TC.Logging\TC.Logging.csproj" />
	</ItemGroup>
</Project>
